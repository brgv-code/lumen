{
  "name": "@lumen/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --local",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.worker.json",
    "db:migrate:local": "wrangler d1 migrations apply lumen-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lumen-db --remote",
    "deploy": "vite build && wrangler deploy",
    "preview": "vite build && wrangler versions upload"
  },
  "dependencies": {
    "@lumen/core": "*",
    "@mozilla/readability": "^0.5.0",
    "dompurify": "^3.2.0",
    "hono": "^4.6.12",
    "linkedom": "^0.18.5",
    "lucide-react": "^0.460.0",
    "marked": "^14.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.45.0"
  },
  "license": "AGPL-3.0-only"
}
