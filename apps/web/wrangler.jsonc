{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumen",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "readwithlumen.app", "custom_domain": true },
    { "pattern": "www.readwithlumen.app", "custom_domain": true }
  ],
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/login", "/pricing", "/billing/*", "/s/*", "/api/*", "/auth/*", "/mcp", "/mcp/*", "/compare", "/compare/*", "/answers", "/answers/*", "/docs", "/docs/*", "/privacy", "/terms", "/changelog", "/sitemap.xml", "/robots.txt", "/llms.txt"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "lumen-db", "database_id": "47eaaa2b-a68e-47ad-92a7-98cc662c2b48", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI", "remote": true },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "triggers": { "crons": ["17 */6 * * *"] },
  "vars": { "DEMO_ENABLED": "true", "OWNER_EMAILS": "hello@bhargav.dev", "AI_SOFT_CAP": "60" },
  "observability": { "enabled": true }
}
